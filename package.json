{
  "name": "deathbench",
  "version": "1.0.0",
  "description": "Measuring machine-made mortality.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.cjs dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "generate:og": "pnpm build && node scripts/generate-opengraph.mjs",
    "typecheck": "react-router typegen && tsc"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "isbot": "^5",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
